{
  "increment": 1,
  "purpose": "prove the extractor and lookup model, not per-member semantics",
  "authority": "queue 533 revised list, approved 535",
  "notRequired": "a fixture per member of a large shared branch merely because it falls through",
  "fixtures": [
    {
      "file": "ordinary-members.json",
      "proves": "one ordinary member per dispatch site, all thirteen sites",
      "expectConstructs": [
        "wc.constant.value-type.date",
        "wc.expression.item.integer",
        "wc.expression.result-type.string",
        "wc.operand.c",
        "wc.operand.d",
        "wc.operand.event-match.x",
        "wc.preset.sunset",
        "wc.preset.value-type.time",
        "wc.statement.action",
        "wc.statement.every",
        "wc.task.value-type.variable",
        "wc.virtual-device.mode",
        "wc.virtual-device.tile"
      ],
      "siteCoverage": {
        "operand.event-match.type": "x",
        "operand.evaluate.type": "d",
        "operand.subscribe.type": "c",
        "expression.item.type": "integer",
        "virtual-device.evaluate.name": "mode",
        "virtual-device.subscribe.name": "tile",
        "preset.evaluate.value-type": "time",
        "preset.evaluate.name": "sunset",
        "constant.evaluate.value-type": "date",
        "expression.evaluate.result-type": "string",
        "task.variable.value-type": "variable",
        "statement.subscribe.timer-type": "every",
        "statement.subscribe.type": "action"
      }
    },
    {
      "file": "empty-operand.json",
      "proves": "t:'' recognised and distinct from missing t",
      "expectConstructs": [
        "wc.operand.empty"
      ],
      "expectDistinct": [
        "present-empty",
        "absent"
      ]
    },
    {
      "file": "shared-branch-numeric.json",
      "proves": "five members survive one shared branch",
      "expectConstructs": [
        "wc.expression.item.decimal",
        "wc.expression.item.double",
        "wc.expression.item.float",
        "wc.expression.item.integer",
        "wc.expression.item.number"
      ],
      "expectCount": 5,
      "note": "must NOT collapse to one construct; sharedBranchGroup is provenance only"
    },
    {
      "file": "unknown-discriminator.json",
      "proves": "unregistered discriminator is reported",
      "expectReason": "unknown-operand-type",
      "note": "must not echo the raw candidate value into the reason or path"
    },
    {
      "file": "nested-switch-trap.json",
      "proves": "event matcher not confused with statement switch",
      "expectConstructs": [
        "wc.operand.event-match.p",
        "wc.operand.event-match.v",
        "wc.operand.event-match.x"
      ]
    },
    {
      "file": "same-spelling-multisite.json",
      "proves": "context-qualified lookup, not flat union",
      "expectConstructs": [
        "wc.operand.event-match.p",
        "wc.operand.p"
      ],
      "expectDistinct": [
        "wc.operand.event-match.p",
        "wc.operand.p"
      ]
    }
  ],
  "idNamespace": "wc.",
  "frozenSites": [
    "operand.event-match.type",
    "operand.evaluate.type",
    "operand.subscribe.type",
    "expression.item.type",
    "virtual-device.evaluate.name",
    "virtual-device.subscribe.name",
    "preset.evaluate.value-type",
    "preset.evaluate.name",
    "constant.evaluate.value-type",
    "expression.evaluate.result-type",
    "task.variable.value-type",
    "statement.subscribe.timer-type",
    "statement.subscribe.type"
  ],
  "canonicalNote": "expectConstructs are canonical saved-document identities. siteCoverage remains generator evidence about which dispatch sites are exercised, which is a different question from what the walker will find in the tree."
}
